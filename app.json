{
  "expo": {
    "name": "LifePilot",
    "slug": "lifepilot",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "lifepilot",
      "com.anupam.lp",
      "com.googleusercontent.apps.753694130355-8bhkicmdd6qqu9esu09qo5c9dv8ab3vi"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anupam.lp",
      "buildNumber": "10",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to securely transcribe your voice commands using native speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone so you can speak to the AI assistant.",
        "NSCalendarsUsageDescription": "Allow $(PRODUCT_NAME) to read your calendar events to help you schedule tasks around your busy days."
      }
    },
    "android": {
      "package": "com.anupam.lp",
      "versionCode": 12,
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.QUERY_ALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 150
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#A78BFA",
          "sounds": [
            "./assets/sounds/custom_alert.wav"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LifePilot uses your approximate location to show weather on your alarm and morning focus screens."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "LifePilot uses the camera for QR code, barcode, and photo dismiss challenges you set up on your alarms."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "LifePilot uses NFC to let you dismiss alarms by tapping a registered NFC tag.",
          "selectIdentifiers": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 34
          }
        }
      ],
      "./plugins/withFullScreenAlarm",
      "./plugins/withNotifeeRepo",
      "./plugins/withWidgetExported",
      "./plugins/withAppBlocker",
      "./plugins/withAppIconVariants",
      "expo-speech-recognition",
      "expo-image",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayTasksWidget",
              "label": "Today Tasks",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeWidth": "640dp",
              "maxResizeHeight": "640dp",
              "resizeMode": "horizontal|vertical",
              "description": "View today's tasks from LifePilot",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "PlannerWidget",
              "label": "Today's Plan",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeWidth": "640dp",
              "maxResizeHeight": "640dp",
              "resizeMode": "horizontal|vertical",
              "description": "Your Aura schedule for today, tickable from the home screen",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "f79f9e16-1938-4c95-a8db-cc580b62f081"
      }
    },
    "owner": "doublethreecompany",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f79f9e16-1938-4c95-a8db-cc580b62f081"
    }
  }
}
