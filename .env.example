# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://rsglapakzhdpjyplxuwt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_cheJ7hTyKYLZaLmvfvpOuw_baQUGfho

# AI API Keys (Get free keys from Google AI Studio, Groq, Mistral, Cohere)
# The AI Engine will cascade through these keys in order if any fail or run out of quota.
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
EXPO_PUBLIC_MISTRAL_API_KEY=your_mistral_api_key_here
EXPO_PUBLIC_COHERE_API_KEY=your_cohere_api_key_here

# Secure backend / proxy URL. Required in store builds; direct provider keys are
# disabled there so no AI secret is ever embedded in the app bundle.
EXPO_PUBLIC_AI_PROXY_URL=
EXPO_PUBLIC_REQUIRE_AI_PROXY=true

# Store builds intentionally keep rich alarms off until that native/policy surface
# is ready. Hustlers can be enabled after its migrations and cron jobs are verified.
EXPO_PUBLIC_ALARMS_ENABLED=false
EXPO_PUBLIC_HUSTLERS_ENABLED=false

# Master monetization switch. When false/omitted, all Play Store billing UI
# (Paywall, Pro banner, RevenueCat init) is hidden/skipped so you can keep
# building features without any Play Console dependency.
#
# Turn this on LAST — only once the RevenueCat key below is set, the products
# exist in Play Console, and a build containing react-native-purchases has been
# installed. Flipping it early gives a visible paywall where every tap is a
# "Coming Soon" alert.
EXPO_PUBLIC_PLAYSTORE_MODE=false

# RevenueCat public Android SDK key (Project → API keys → Android). Safe to ship:
# it is a publishable key, and entitlements/credits are granted server-side by the
# revenuecat-webhook edge function, never by the client.
#
# Billing stays hard-off unless ALL of these hold (see src/lib/purchases.js):
#   1. this key is set
#   2. react-native-purchases is installed  → it is, pinned at 10.8.0
#   3. the NATIVE module is present         → requires a fresh dev/production
#                                             build; an OTA update cannot add it
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob. The Android app id is hardcoded in app.config.js on purpose (the native
# SDK aborts at launch if the manifest id is missing). Only the rewarded unit and
# test devices are runtime config.
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=
EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
