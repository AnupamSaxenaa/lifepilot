    "build:apk": "eas build --platform android --profile production-apk --local",
    "build:play": "eas build --platform android --profile play-production --non-interactive",
    "update:store": "zsh ./scripts/publish-store-update.sh",
    "dev:android": "expo run:android --variant debug",
    "lint:fix": "npm run lint -- --fix",
    "adb:wifi": "./scripts/adb-wifi.sh",
    "adb:wifi:status": "./scripts/adb-wifi.sh --status",
    "adb:wifi:install": "./scripts/adb-wifi-install.sh",
