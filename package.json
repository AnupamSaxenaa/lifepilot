    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --no-cache App.js src app.config.js babel.config.js eslint.config.js jest.config.js metro.config.js react-native.config.js tailwind.config.js scripts plugins test tools",
    "test": "jest",
    "legal:build": "node scripts/build-legal-pages.js",
    "check": "node scripts/build-legal-pages.js --check && for f in scripts/check-*.js; do echo \"--- $f\"; node \"$f\" || exit 1; done",
